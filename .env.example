# Never commit real API keys or lead data.
# Copy this file to .env.local and fill values locally.
APP_ENV=local
APP_BASE_URL=http://localhost:5173

# Research discovery credentials
YOUTUBE_API_KEY=
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
BEGLIB_RESEARCH_USER_AGENT=beGlibCommercialAutomation/0.1 (creator-source-discovery; local private research)

# Future integrations
OPENAI_API_KEY=
POSTGRES_URL=
REDIS_URL=
OPENALEX_MAILTO=

# Outreach email sending (AWS SES)
# Trusted local server process only. Never expose these in Vite, browser bundles, localStorage, exports, or dashboards.
# This identity is deliberately separate from the Conversio transactional sender so that
# cold-outreach bounce/complaint reputation can never pause transactional Host mail.
OUTREACH_EMAIL_MODE=off
OUTREACH_EMAIL_ENV=local
OUTREACH_CAMPAIGN_ID=host-pilot-001

# Leave the AWS credential pair empty to use the ambient AWS credential chain (profile, SSO, instance role).
# Set them explicitly to pin outreach to its own restricted IAM user.
OUTREACH_AWS_REGION=ca-central-1
OUTREACH_AWS_ACCESS_KEY_ID=
OUTREACH_AWS_SECRET_ACCESS_KEY=
OUTREACH_SES_CONFIGURATION_SET=beglib-outreach

# Sender identity. Every commercial message renders these into a footer that cannot be removed.
OUTREACH_FROM_ADDRESS=hosts@outreach.beglib.com
OUTREACH_FROM_NAME=beGlib Host Team
OUTREACH_REPLY_TO_ADDRESS=
OUTREACH_UNSUBSCRIBE_MAILTO=
OUTREACH_SENDER_LEGAL_NAME=
PHYSICAL_MAILING_ADDRESS=

# SES configuration-set event destination -> SNS -> SQS. Polled locally; no public webhook is exposed.
OUTREACH_SES_EVENT_QUEUE_URL=

# Local outreach server. Binds to loopback only; the token guards against other local processes.
OUTREACH_SERVER_PORT=5174
OUTREACH_SERVER_TOKEN=

# Host Prospect internal API credentials
# Trusted local/server process only. Never expose these in Vite, browser bundles, localStorage, exports, or dashboards.
HOST_PROSPECT_API_BASE_URL=https://api.beglib.com
# The smoke command is non-production only and refuses api.beglib.com outright.
# Point it at a beta/staging origin; verify production with the checklist in
# docs/host-prospect-integration.md instead.
HOST_PROSPECT_SMOKE_ENV=beta
HOST_PROSPECT_HMAC_KEY_ID=
HOST_PROSPECT_HMAC_SECRET=
# Conversio mints the CTA on its own PUBLIC_WEB_BASE_URL, which in production is
# app.beglib.com. This allowlist is an exact origin match, so listing the bare apex
# would reject every production CTA.
HOST_PROSPECT_ALLOWED_CTA_ORIGINS=https://app.beglib.com
HOST_PROSPECT_STATE_PATH=./exports/host-prospect-state.local.json

# Compliance controls
OUTREACH_REQUIRE_HUMAN_APPROVAL=true
OUTREACH_DAILY_SEND_LIMIT=25
OUTREACH_MAX_ATTEMPTS=3
OUTREACH_VERIFICATION_MAX_AGE_DAYS=90
SUPPRESSION_LIST_PATH=./data/outreach-suppression.local.json

# Hand-entered candidates and operator review outcomes. Kept out of the generated dossier
# export on purpose: rebuilding the pool overwrites exports/, and operator work must survive
# that. Merged over the export at read time by the dashboard and the outreach server.
CANDIDATE_OVERLAY_PATH=./data/candidate-overlay.local.json
