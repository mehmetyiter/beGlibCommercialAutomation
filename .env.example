# Never commit real API keys or lead data.
# Copy this file to .env.local and fill values locally.
APP_ENV=local
APP_BASE_URL=http://localhost:5173

# Research discovery credentials
YOUTUBE_API_KEY=
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
BEGLIB_RESEARCH_USER_AGENT=beGlibCommercialAutomation/0.1 (creator-source-discovery; local private research)

# Future integrations
OPENAI_API_KEY=
POSTGRES_URL=
REDIS_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
PHYSICAL_MAILING_ADDRESS=
OPENALEX_MAILTO=

# Host Prospect internal API credentials
# Trusted local/server process only. Never expose these in Vite, browser bundles, localStorage, exports, or dashboards.
HOST_PROSPECT_API_BASE_URL=https://api.beglib.com
HOST_PROSPECT_SMOKE_ENV=beta
HOST_PROSPECT_HMAC_KEY_ID=
HOST_PROSPECT_HMAC_SECRET=
HOST_PROSPECT_ALLOWED_CTA_ORIGINS=https://beglib.com

# Compliance controls
OUTREACH_REQUIRE_HUMAN_APPROVAL=true
OUTREACH_DAILY_SEND_LIMIT=25
SUPPRESSION_LIST_PATH=./data/suppression-list.local.json
